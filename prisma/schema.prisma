// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  admin
  funcionario
}

enum Provedor {
  local
  google
}

enum TipoVaga {
  comum
  coberta
  mensalista
}

enum StatusVaga {
  livre
  ocupada
}

enum StatusTicket {
  aberto
  fechado
}

enum StatusMensalidade {
  pendente
  paga
  cancelada
}

model Usuario {
  id              String    @id @default(cuid())
  nome            String
  cpf             String?   @unique
  email           String    @unique
  senha           String?
  telefone        String?
  endereco        String?
  dataNascimento  DateTime?
  avatar          String?
  role            Papel     @default(funcionario)
  ativo           Boolean   @default(true)
  aceitouTermos   Boolean   @default(false)
  provedor        Provedor  @default(local)
  senhaTemporaria Boolean   @default(false)
  senhaAlteradaEm DateTime?
  criadoEm        DateTime  @default(now())

  resetSenhaCodigos     ResetSenhaCodigo[]
  mensalidadesAlteradas Mensalidade[]

  @@map("usuarios")
}

/**
 * Código de verificação de "esqueci minha senha", enviado por e-mail.
 * Guardamos só o hash do código (nunca o valor em texto puro) e ele vale
 * por tempo limitado e uso único — ver RESET_TTL_MINUTOS em
 * server/controllers/auth.js.
 */
model ResetSenhaCodigo {
  id         String   @id @default(cuid())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  usuarioId  String
  codigoHash String
  expiraEm   DateTime
  usado      Boolean  @default(false)
  criadoEm   DateTime @default(now())

  @@map("reset_senha_codigos")
}

model Mensalista {
  id               String   @id @default(cuid())
  nome             String
  cpf              String   @unique
  placa            String   @unique
  telefone         String
  valorMensalidade Decimal  @default(0) @db.Decimal(10, 2)
  // Perfil do plano (ex.: "Mensal Integral", "Noturno", "Corporativo") —
  // texto livre como Tarifa.categoria, pra não exigir migration toda vez
  // que surgir uma categoria nova.
  categoriaPlano   String   @default("Mensal Integral")
  ativo            Boolean  @default(true)
  criadoEm         DateTime @default(now())

  tickets      Ticket[]
  mensalidades Mensalidade[]

  @@map("mensalistas")
}

/**
 * Um registro por ciclo de 30 dias corridos de um mensalista (não por
 * ticket): nasce cobrado na primeira entrada em que não há ciclo vigente —
 * ver MensalidadeCicloService — não no cadastro nem num dia fixo do mês.
 */
model Mensalidade {
  id                  String            @id @default(cuid())
  mensalista          Mensalista        @relation(fields: [mensalistaId], references: [id])
  mensalistaId        String
  referencia          String // mês de início do ciclo, ex.: "2026-08"
  dataInicio          DateTime
  dataFim             DateTime
  diasCobrados        Int
  diasNoMes           Int
  valor               Decimal           @db.Decimal(10, 2)
  status              StatusMensalidade @default(pendente)
  formaPagamento      String?
  // Só preenchido quando status = cancelada — justificativa do cancelamento
  // (ex.: "Cliente desistiu", "Cobrança em duplicidade"), usada nos
  // relatórios de motivo de perda em Faturamento.
  motivoCancelamento  String?
  criadoEm            DateTime          @default(now())

  // Auditoria da última alteração manual de status feita em Faturamento
  // (marcar como paga / cancelar) — nula quando o ciclo nasce cobrado
  // automaticamente no fechamento de um ticket (ver MensalidadeCicloService),
  // já que aí não existe um operador "dando baixa" na tela de Faturamento.
  alteradoPor   Usuario?  @relation(fields: [alteradoPorId], references: [id], onDelete: SetNull)
  alteradoPorId String?
  alteradoEm    DateTime?

  @@unique([mensalistaId, referencia])
  @@map("mensalidades")
}

model Vaga {
  id        String     @id @default(cuid())
  codigo    String     @unique
  tipo      TipoVaga   @default(comum)
  status    StatusVaga @default(livre)
  acessivel Boolean    @default(false)

  tickets Ticket[]

  @@map("vagas")
}

model Tarifa {
  id        String  @id @default(cuid())
  categoria String
  valorHora Decimal @db.Decimal(10, 2)

  tickets Ticket[]

  @@map("tarifas")
}

model Ticket {
  id             String       @id @default(cuid())
  placa          String
  status         StatusTicket @default(aberto)
  dataEntrada    DateTime     @default(now())
  dataSaida      DateTime?
  valorTotal     Decimal?     @db.Decimal(10, 2)
  formaPagamento String?

  vaga   Vaga   @relation(fields: [vagaId], references: [id])
  vagaId String

  tarifa   Tarifa? @relation(fields: [tarifaId], references: [id])
  tarifaId String?

  mensalista   Mensalista? @relation(fields: [mensalistaId], references: [id])
  mensalistaId String?

  @@map("tickets")
}

/**
 * Evento de uso da interface (product analytics), só gravado depois que a
 * pessoa aceita o aviso de LGPD (ver assets/js/modules/lgpd.js e
 * assets/js/modules/telemetria.js). De propósito sem nenhuma coluna que
 * identifique quem gerou o evento (sem usuarioId, sem IP).
 */
model EventoUso {
  id        String   @id @default(cuid())
  tipo      String
  tela      String
  duracaoMs Int?
  criadoEm  DateTime @default(now())

  @@index([tela])
  @@index([criadoEm])
  @@map("eventos_uso")
}
