DATABASE_URL="postgresql://usuario:senha@localhost:5432/parkgestao?schema=public"

PORT=3001
JWT_SECRET="troque-por-uma-chave-secreta-longa-e-aleatoria"
JWT_EXPIRES_IN="8h"

# Opcional — habilita o botão "Entrar com Google" (ver README)
GOOGLE_CLIENT_ID=

# Opcional — lista de origens permitidas pelo CORS, separadas por vírgula
# (ex.: "http://localhost:5500,https://meudominio.com"). Sem essa variável a
# API aceita qualquer origem — ok em dev, defina em produção.
CORS_ORIGIN=

# Opcional — habilita o envio real do código de "esqueci minha senha" por
# e-mail (ver README). Sem essas variáveis, a recuperação de senha fica
# indisponível (erro claro, em vez de falhar silenciosamente).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Opcional — remetente exibido no e-mail; se vazio, usa SMTP_USER.
SMTP_FROM=
